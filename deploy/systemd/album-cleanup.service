[Unit]
Description=Album daily cleanup (Trash, abandoned uploads, expired links)
After=postgresql.service

[Service]
Type=oneshot
User=album
Group=album
WorkingDirectory=@APP_DIR@/worker
EnvironmentFile=/etc/album/album.env
ExecStart=/opt/node22/bin/node dist/server.mjs --cleanup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

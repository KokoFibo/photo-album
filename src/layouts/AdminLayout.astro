---
import "../styles/global.css";
import AdminNav from "../components/AdminNav.vue";
const { title } = Astro.props;
---
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="robots" content="noindex, nofollow, noarchive" /><title>{title} · Administration</title>
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem("theme")||"dark"}catch(e){}</script></head>
<body class="min-h-screen"><AdminNav client:load path={Astro.url.pathname} />
<main class="px-4 py-8 lg:ml-60 lg:px-10"><h1 class="mb-1 text-4xl font-semibold tracking-tight">{title}</h1>
<p class="mb-8 text-sm text-muted">Operational and account metadata only. Private photos, albums, GPS data and Trash are never shown here.</p><slot /></main></body></html>

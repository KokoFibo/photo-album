# Copy to tests/.env. Use TEST accounts: the script creates and then deletes a few fake photos and one album.
# MEMBER_* must be a normal member (not an admin). ADMIN_* must be the Super Admin.
MEMBER_EMAIL=member@example.com
MEMBER_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
API=http://localhost:8787
APP=http://localhost:4321
# Optional but recommended (enables the quota, expiry and sign-up checks). Same value as DATABASE_ADMIN_URL in db/.env
DATABASE_ADMIN_URL=
